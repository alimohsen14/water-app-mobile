{
  "expo": {
    "name": "water-meter-app",
    "slug": "water-meter-app",
    "scheme": "watermeterapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/water-meter-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alimo14.watermeterapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/water-meter-app-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alimo14.watermeterapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-blank.png",
          "imageWidth": 1
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b385d994-ccab-4560-8abb-33f8029667c3"
      }
    }
  }
}
